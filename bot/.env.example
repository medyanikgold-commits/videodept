# Настройки бота видеоотдела. Скопируй в .env и заполни (install.sh спросит главное сам).

# Токен бота от @BotFather (создай НОВОГО бота, не тот, что уже работает)
BOT_TOKEN=
# Твой Telegram ID (узнать у @userinfobot). Если пусто, владельцем станет первый, кто напишет боту
OWNER_ID=
# Ключ Claude API с console.anthropic.com
ANTHROPIC_API_KEY=

# Куда публиковать. Telegram-канал: бот должен быть админом канала
CHANNEL_ID=
# VK: токен пользователя с правами video и wall, и ID сообщества (цифры)
VK_USER_TOKEN=
VK_GROUP_ID=

# Расписание ИИ-роликов (по Москве) и автопубликация без одобрения (1 = да)
DAILY_TIMES=09:00,13:00
TIMEZONE=Europe/Moscow
AUTO_PUBLISH=0

# Распознавание речи: tiny, base, small (по умолчанию), medium (нужно 4 ГБ памяти)
WHISPER_MODEL=small
# Фоновая музыка для всех роликов (путь к mp3 на сервере), можно оставить пустым
MUSIC_FILE=

# Для видео больше 20 МБ: свой сервер Telegram API (install.sh настроит, если указать ключи с my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOCAL_BOT_API=
